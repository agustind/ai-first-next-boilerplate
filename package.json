{
  "name": "ai-first-next-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip",
    "check": "npm run lint && npm run typecheck && npm run test && npm run knip",
    "init": "tsx scripts/init-project.ts",
    "new:section": "plop section",
    "mcp": "tsx scripts/mcp/stdio.ts",
    "sanity:extract": "sanity schema extract --path sanity-schema.json",
    "sanity:seed": "tsx scripts/seed-sanity.ts",
    "directus:up": "docker compose -f directus/docker-compose.yml up -d",
    "directus:bootstrap": "tsx scripts/directus-bootstrap.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@directus/sdk": "^27.0.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@portabletext/react": "^7.0.1",
    "@sanity/client": "^8.11.0",
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.20.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "clsx": "^2.1.1",
    "next": "^16.4.3",
    "next-sanity": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "sanity": "^6.18.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "node-html-parser": "^9.0.5",
    "plop": "^4.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
