# Copy to .env.local and fill in. Every variable is optional: with nothing set the
# site runs on the built-in demo content so you can develop before a CMS exists.

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── CMS ─────────────────────────────────────────────────────────────────────
# sanity | directus | demo. Leave empty to infer from the credentials below.
CMS_PROVIDER=

# Sanity (https://www.sanity.io/manage). `npx sanity init --env` fills these.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Viewer token: draft mode, visual editing, Live preview.
SANITY_API_READ_TOKEN=
# Editor token: form submissions and `npm run sanity:seed`. Server only.
SANITY_API_WRITE_TOKEN=

# Directus (`npm run directus:up` starts one locally on :8055)
DIRECTUS_URL=
DIRECTUS_TOKEN=

# Shared secret for POST /api/revalidate (Directus flows, CI, scripts). 16+ chars.
REVALIDATE_SECRET=

# ── Access ──────────────────────────────────────────────────────────────────
# Set SITE_PASSWORD to put the whole site behind HTTP basic auth (staging).
SITE_USERNAME=preview
SITE_PASSWORD=

# ── Forms ───────────────────────────────────────────────────────────────────
# Optional email notification via Resend (https://resend.com)
RESEND_API_KEY=
FORMS_NOTIFY_EMAIL=
FORMS_FROM_EMAIL="Website <forms@example.com>"
# Optional Cloudflare Turnstile. Honeypot + timing checks run regardless.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Agents ──────────────────────────────────────────────────────────────────
# allow | block — model-training crawlers (GPTBot, CCBot, ...). AI search/answer
# bots (OAI-SearchBot, PerplexityBot, Claude-SearchBot...) are always allowed.
AI_TRAINING_CRAWLERS=allow
# Expose the read-only public MCP endpoint at /api/mcp
PUBLIC_MCP_ENABLED=true

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
