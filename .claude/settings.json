{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": false,
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run knip)",
      "Bash(npm run build)",
      "Bash(npm run new:section:*)",
      "Bash(npx biome check:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx next typegen)",
      "mcp__site-check__list_sections",
      "mcp__site-check__audit_page",
      "mcp__site-check__crawl_site",
      "mcp__site-check__check_agent_readiness",
      "mcp__site-check__run_checks"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  }
}
